#!/bin/sh
# Managed by Codebase Analysis AI.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
checker="$repo_root/tools/codebase-analysis-ai/check.py"
[ -f "$checker" ] || exit 0

if command -v python3 >/dev/null 2>&1; then py=python3
elif command -v python >/dev/null 2>&1; then py=python
elif command -v py >/dev/null 2>&1; then py="py -3"
else
  echo "Codebase Analysis AI: Python 3 is required." >&2
  exit 1
fi

if $py "$checker" check --mode pre-push --read-pre-push-stdin --json; then
  exit 0
fi

echo "Codebase Analysis AI: push blocked because documentation hashes do not match the current source files." >&2
echo "Reason details are available in the JSON report above." >&2
echo "To force this push, run: git push --no-verify" >&2
exit 1
